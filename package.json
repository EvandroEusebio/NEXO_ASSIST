{
  "name": "nexo_ass",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck && pnpm db:typecheck",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:typecheck": "tsc --project tsconfig.db.json --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:check": "tsx scripts/check-seed.ts",
    "db:smoke": "tsx scripts/db-smoke.ts"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.158",
    "@mastra/ai-sdk": "^1.11.2",
    "@mastra/core": "^1.79.0",
    "@mastra/duckdb": "^1.15.0",
    "@mastra/libsql": "^1.27.0",
    "@mastra/loggers": "^1.3.9",
    "@mastra/memory": "^1.39.0",
    "@mastra/observability": "^1.21.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "ai": "^7.0.154",
    "dotenv": "^18.0.9",
    "mastra": "^1.35.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
